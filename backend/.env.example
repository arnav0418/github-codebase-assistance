# --- LLM provider: "ollama" (local dev) or "gemini" (deployed) ---
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Used when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings always run locally, in-process (same in dev and deployment)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector store (on-disk Chroma)
CHROMA_DIR=./chroma_data
CHROMA_COLLECTION=code_chunks

# Retrieval
TOP_K=8

# Where cloned repos are checked out
CLONE_DIR=./repo_cache

# Comma-separated allowed origins; add your Vercel URL in deployment
CORS_ORIGINS=http://localhost:5173
